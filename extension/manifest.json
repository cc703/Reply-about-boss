{
  "manifest_version": 3,
  "name": "BOSS Chat Listener",
  "version": "0.12.0",
  "description": "Detects BOSS web chat records and requests local reply draft suggestions.",
  "action": {
    "default_title": "BOSS Chat Listener",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "https://*.zhipin.com/*"
      ],
      "js": [
        "src/conversationExtractor.js",
        "src/messageExtractor.js",
        "src/panel.js",
        "src/replyDraftClient.js",
        "src/content.js"
      ],
      "css": [
        "styles/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ]
}
